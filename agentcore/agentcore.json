{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "FlightBookingSupport",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "FlightBookingSupport"
  },
  "runtimes": [
    {
      "name": "FlightBookingAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/FlightBookingAgent/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "requestHeaderAllowlist": [
        "Authorization"
      ],
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://cognito-idp.us-east-1.amazonaws.com/us-east-1_UqVgmTUWo/.well-known/openid-configuration",
          "allowedClients": [
            "48rmngdj0llmlglsj2ttjothee"
          ]
        }
      }
    }
  ],
  "memories": [
    {
      "name": "SharedMemory",
      "eventExpiryDuration": 7,
      "strategies": [
        {
          "type": "SEMANTIC",
          "namespaceTemplates": [
            "/users/{actorId}/facts"
          ]
        },
        {
          "type": "SUMMARIZATION",
          "namespaceTemplates": [
            "/summaries/{actorId}/{sessionId}"
          ]
        },
        {
          "type": "USER_PREFERENCE",
          "namespaceTemplates": [
            "/users/{actorId}/preferences"
          ]
        },
        {
          "type": "EPISODIC",
          "namespaceTemplates": [
            "/episodes/{actorId}/{sessionId}"
          ],
          "reflectionNamespaceTemplates": [
            "/episodes/{actorId}"
          ]
        }
      ]
    }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [
    {
      "name": "QualityMonitor",
      "agent": "FlightBookingAgent",
      "evaluators": [
        "Builtin.GoalSuccessRate",
        "Builtin.Correctness",
        "Builtin.ToolSelectionAccuracy"
      ],
      "samplingRate": 100,
      "enableOnCreate": true
    }
  ],
  "agentCoreGateways": [
    {
      "name": "My-Gateway-Secure",
      "protocolType": "None",
      "description": "Gateway for My-Gateway-Secure",
      "targets": [
        {
          "name": "FarePolicies",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "arn:aws:lambda:us-east-1:742752463290:function:workshop-get-fare-policy",
            "toolSchemaFile": "app/FlightBookingAgent/tool/farepolicy_schema.json"
          }
        }
      ],
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://cognito-idp.us-east-1.amazonaws.com/us-east-1_UqVgmTUWo/.well-known/openid-configuration",
          "allowedClients": [
            "48rmngdj0llmlglsj2ttjothee"
          ]
        }
      },
      "enableSemanticSearch": true,
      "exceptionLevel": "NONE"
    }
  ],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}